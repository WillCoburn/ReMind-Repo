rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User doc and ALL subcollections
    match /users/{uid} {
      // Users may read/delete their own profile, but may only create/update
      // explicitly user-controlled fields. Billing, entitlement, SMS delivery,
      // usage, and metric fields are server-owned.
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
                    && request.resource.data.keys().hasOnly(safeUserProfileFields())
                    && validUserProfileWrite(uid);
      allow update: if isSelf(uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(safeUserProfileFields())
                    && validUserProfileWrite(uid);
      allow delete: if isSelf(uid);

      // entries subcollection
      match /entries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // meta subcollection (settings lives here)
      match /meta/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // affirmations (you have this in your app, even if unused)
      match /affirmations/{affirmationId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // blocked users subcollection
      match /blockedUsers/{blockedUid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Community posts logic (unchanged)
    match /communityPosts/{postId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /comments/{commentId} {
        allow read: if true;
        allow create, update, delete: if false;

        match /likes/{uid} {
          allow read: if true;
          allow create: if isSelf(uid) &&
                        !exists(/databases/$(database)/documents/communityPosts/$(postId)/comments/$(commentId)/likes/$(uid));
          allow delete: if isSelf(uid);
          allow update: if false;
        }

        match /flags/{uid} {
          allow read: if true;
          allow create: if isSelf(uid) &&
                        !exists(/databases/$(database)/documents/communityPosts/$(postId)/comments/$(commentId)/flags/$(uid));
          allow delete: if isSelf(uid);
          allow update: if false;
        }
      }
      match /likes/{uid} {
        allow read: if true;
        allow create: if isSelf(uid) &&
                      !exists(/databases/$(database)/documents/communityPosts/$(postId)/likes/$(uid));
        allow delete: if isSelf(uid);
        allow update: if false;
      }

      match /reports/{uid} {
        allow read: if true;
        allow create: if isSelf(uid) &&
                      !exists(/databases/$(database)/documents/communityPosts/$(postId)/reports/$(uid));
        allow delete: if isSelf(uid);
        allow update: if false;
      }
    }

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function safeUserProfileFields() {
      return [
        "uid",
        "phoneE164",
        "createdAt",
        "updatedAt",
        "hasSeenFeatureTour"
      ];
    }

    function validUserProfileWrite(uid) {
      return (!("uid" in request.resource.data) || request.resource.data.uid == uid)
             && (!("phoneE164" in request.resource.data) || request.resource.data.phoneE164 is string)
             && (!("hasSeenFeatureTour" in request.resource.data) || request.resource.data.hasSeenFeatureTour is bool);
    }
  }
}
